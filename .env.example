# ==============================================================================
# Email Threat Detection Platform — Root Environment Reference
# Target Architecture: Render (Backend) + Vercel (Frontend) + Supabase (PostgreSQL) + Groq
# ==============================================================================

# Application Environment
APP_ENV=production
APP_NAME="Email Threat Detection API"
DEBUG=false
LOG_LEVEL=INFO

# Backend Free-Tier Settings
REDIS_REQUIRED=false
DEMO_MODE=true
DEFAULT_TENANT_ID=a0000000-0000-0000-0000-000000000001

# CORS settings for deployed Vercel frontend
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Supabase PostgreSQL Connection String (Transaction Pooler port 6543 or Session pooler)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# JWT Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq AI Provider (Server-side API key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT_SECONDS=30

# Optional Threat Intelligence
VIRUSTOTAL_API_KEY=

# Frontend Environment Variables (Set in Vercel Project Settings)
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api/v1
VITE_WS_URL=wss://your-backend-api.onrender.com
VITE_APP_ENV=production
