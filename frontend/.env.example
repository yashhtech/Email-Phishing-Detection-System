# ==============================================================================
# Email Threat Detection Platform — Frontend Environment Configuration
# ==============================================================================

# Render backend URL (include /api/v1 or just base root; the client handles both)
# Example for deployed Render service: https://email-threat-api.onrender.com/api/v1
# Example for local development: http://localhost:8000/api/v1
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api/v1

# WebSocket URL (optional - derived automatically from VITE_API_BASE_URL if omitted)
# Example for deployed Render service: wss://email-threat-api.onrender.com
# Example for local development: ws://localhost:8000
VITE_WS_URL=wss://your-backend-api.onrender.com

# Environment indicator
VITE_APP_ENV=production
