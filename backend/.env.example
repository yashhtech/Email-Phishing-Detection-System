# ==============================================================================
# Email Threat Detection Platform — Backend Environment Configuration
# ==============================================================================

# ---- Application ----
APP_ENV=production
APP_NAME="Email Threat Detection API"
DEBUG=false
LOG_LEVEL=INFO

# For CORS: comma-separated list of origins or JSON array.
# Example for deployed frontend: https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
# Regex to match all Vercel preview/production deployments automatically
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Demo & Default Tenant
DEMO_MODE=true
DEFAULT_TENANT_ID=a0000000-0000-0000-0000-000000000001

# ---- Database (Supabase Free Tier / Cloud PostgreSQL) ----
# Supabase connection string format:
# Transaction pooler (Port 6543, recommended for serverless/free tier):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct connection (Port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Note: postgres:// and postgresql:// prefixes are automatically converted to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/email_threat_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ---- Standalone Free-Tier Mode (No Redis needed) ----
# Set to false to run the worker pool and token blocklist in-memory without Redis on Render free tier
REDIS_REQUIRED=false

# ---- Redis (Optional - for distributed Celery / shared cache) ----
# Leave empty or omit if running on free tier without Redis
REDIS_URL=
REDIS_MAX_CONNECTIONS=10

# ---- JWT Authentication ----
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- External AI Provider (Groq API) ----
# Free server-side Groq API key from https://console.groq.com
# If left empty, deterministic analyzers and ML models still execute; LLM semantic analysis will be skipped gracefully.
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT_SECONDS=30

# ---- External Threat Intelligence (Optional) ----
VIRUSTOTAL_API_KEY=
